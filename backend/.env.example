# =============================================================================
# backend/.env.example
#
# SETUP: Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to Git. It's in .gitignore already.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=True
FRONTEND_URL=http://localhost:5173

# ── Gemini Flash (FREE) ────────────────────────────────────────────────────────
# Get key at: https://aistudio.google.com/app/apikey (free tier: 15 req/min)
GEMINI_API_KEY=

# ── Primary LLM Provider for GD Simulation ───────────────────────────────────
# "gemini" = Gemini first, Groq fallback
# "groq"   = Groq first, Gemini fallback
LLM_PRIMARY_PROVIDER=gemini

# ── STT Provider ──────────────────────────────────────────────────────────────
# "web_speech" = browser-native (MVP, zero cost, Chrome-only)
# "groq"       = Groq Whisper (free 6K min/day, works everywhere)
STT_PROVIDER=web_speech

# ── Groq STT (only if STT_PROVIDER=groq) ──────────────────────────────────────
# Get key at: https://console.groq.com (free tier)
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=12000

# ── Firebase ──────────────────────────────────────────────────────────────────
# Download serviceAccountKey.json from Firebase Console:
# Project Settings → Service Accounts → Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=gd-sim

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=gd_topics
