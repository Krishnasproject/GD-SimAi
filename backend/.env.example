# MockTalk Backend Configuration Template
# Copy this to .env and fill in your actual keys

# Google Gemini API Keys (Comma separated if multiple)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2

# Groq API Key (for STT)
GROQ_API_KEY=your_groq_key

# Firebase Configuration
# Place your serviceAccountKey.json in the backend folder
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
DATABASE_URL=your_firestore_db_url

# Application Settings
DEBUG=True
PORT=8000
